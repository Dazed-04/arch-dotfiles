[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = fifo
source = /tmp/mpd.fifo

[output]
# Required for rmpc to display the visualizer internally
method = raw
raw_target = /dev/stdout
data_format = binary
bit_format = 16bit

[color]
# Using Matugen to create a dynamic gradient
gradient = 1
gradient_count = 8
gradient_color_1 = '#ffb4aa'
gradient_color_2 = '#73342c'
gradient_color_3 = '#e7bdb7'
gradient_color_4 = '#5d3f3b'
gradient_color_5 = '#dfc38c'
gradient_color_6 = '#574419'
gradient_color_7 = '#ffb4ab'
gradient_color_8 = '#a08c8a'

[smoothing]
noise_reduction = 77
