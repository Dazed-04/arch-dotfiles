[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = fifo
source = /tmp/mpd.fifo

[output]
# Required for rmpc to display the visualizer internally
method = raw
raw_target = /dev/stdout
data_format = binary
bit_format = 16bit

[color]
# Using Matugen to create a dynamic gradient
gradient = 1
gradient_count = 8
gradient_color_1 = '#9ecafc'
gradient_color_2 = '#154974'
gradient_color_3 = '#bac8db'
gradient_color_4 = '#3b4857'
gradient_color_5 = '#d5bee5'
gradient_color_6 = '#514060'
gradient_color_7 = '#ffb4ab'
gradient_color_8 = '#8c9199'

[smoothing]
noise_reduction = 77
