{
    "label" : "lock",
    "action" : "sleep 0.25 && hyprlock",
    "text" : "[L]ock",
    "keybind" : "l"
}
{
    "label" : "shutdown",
    "action" : "sleep 0.25 && uwsm app -- hyprshutdown --post-cmd 'systemctl poweroff'",
    "text" : "[S]hutdown",
    "keybind" : "s"
}
{
    "label" : "logout",
    "action" : "sleep 0.25 && uwsm app -- hyprshutdown",
    "text" : "L[o]gout",
    "keybind" : "o"
}
{
    "label" : "reboot",
    "action" : "sleep 0.25 && uwsm app -- hyprshutdown --post-cmd 'systemctl reboot'",
    "text" : "[R]eboot",
    "keybind" : "r"
}
{
    "label" : "sleep",
    "action" : "sleep 0.25 && systemctl suspend",
    "text" : "Slee[p]",
    "keybind" : "p"
}

