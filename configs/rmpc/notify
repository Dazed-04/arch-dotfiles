#!/usr/bin/env bash

# Not while rmpc is the focused window
active_class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty')
[[ $active_class == rmpc ]] && exit 0

TMP_DIR="/tmp/rmpc"
mkdir -p "$TMP_DIR"
ALBUM_ART_PATH="$TMP_DIR/notification_cover"
DEFAULT_ART_PATH="$TMP_DIR/default_album_art.jpg"

# Escape text for notification markup (an "&" in "Simon & Garfunkel" would break it)
esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' <<<"$1"; }

rmpc albumart --output "$ALBUM_ART_PATH" || ALBUM_ART_PATH="$DEFAULT_ART_PATH"

# Downloaded files often carry "Artist - Song" as the title tag. Drop that prefix so the
# heading is just the song name (the artist is shown on the second line anyway).
song=$TITLE
if [[ -n $ARTIST && ${TITLE,,} == "${ARTIST,,} - "* ]]; then
  song=${TITLE:$((${#ARTIST} + 3))}
fi

# Second line: "artist - album"; either part is left out when its tag is missing
details=""
[[ -n $ARTIST ]] && details="<b>$(esc "$ARTIST")</b>"
[[ -n $ALBUM ]] && details+="${details:+ - }<i>$(esc "$ALBUM")</i>"

# -a rmpc: notificationSound.sh keeps this app silent. The sync hint makes each new song
# replace the previous popup instead of stacking.
notify-send -a rmpc -i "$ALBUM_ART_PATH" -h string:x-canonical-private-synchronous:music-track \
  "$(esc "${song^^}")" "$details"
